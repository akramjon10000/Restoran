# Google Gemini Multimodal Live API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Live Model: gemini-3.8-live, gemini-3.8-flash-live-preview, gemini-3.1-flash-live-preview, gemini-3.0-flash-live-preview
GEMINI_LIVE_MODEL=gemini-3.8-live

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# Client-side Telegram fallback (optional if using serverless /api/telegram)
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# Payment Providers (Click, Payme, Uzum Pay)
VITE_CLICK_SERVICE_ID=32541
VITE_CLICK_MERCHANT_ID=24185
VITE_PAYME_MERCHANT_ID=64a7c8d9e1f23456789abcde
VITE_UZUM_SERVICE_ID=restoran_uz

# Google Maps Platform (Optional - Leaflet & OpenStreetMap used as automatic fallback)
GOOGLE_MAPS_PLATFORM_KEY=

# Admin Access Control
ADMIN_PHONES=+998901234567,+998991234567,TG_ADMIN
ADMIN_EMAILS=akramjon10000@gmail.com,admin@restoran.uz
